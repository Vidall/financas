generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String          @id @default(uuid()) @db.VarChar(36)
  nome          String          @db.VarChar(255)
  email         String          @unique @db.VarChar(255)
  senhaHash     String          @db.VarChar(255)
  criadoEm     DateTime        @default(now())
  planos        PlanoMensal[]
  contas        ContaBancaria[]
  refreshTokens RefreshToken[]

  @@map("usuarios")
}

model ContaBancaria {
  id        String  @id @default(uuid()) @db.VarChar(36)
  usuarioId String  @db.VarChar(36)
  banco     String  @db.VarChar(255)
  saldo     Float   @default(0)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("contas_bancarias")
}

model PlanoMensal {
  id                String          @id @default(uuid()) @db.VarChar(36)
  usuarioId         String          @db.VarChar(36)
  mes               Int
  ano               Int
  salarioReferencia Float
  criadoEm         DateTime        @default(now())
  usuario           Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  entradas          Entrada[]
  contasFixas       ContaFixa[]
  gastosVariaveis   GastoVariavel[]
  metas             Meta[]

  @@unique([usuarioId, mes, ano])
  @@map("planos_mensais")
}

model Entrada {
  id            String      @id @default(uuid()) @db.VarChar(36)
  planoMensalId String      @db.VarChar(36)
  nome          String      @db.VarChar(255)
  valor         Float
  recebido      Boolean     @default(false)
  data          DateTime?
  planoMensal   PlanoMensal @relation(fields: [planoMensalId], references: [id], onDelete: Cascade)

  @@map("entradas")
}

model ContaFixa {
  id             String      @id @default(uuid()) @db.VarChar(36)
  planoMensalId  String      @db.VarChar(36)
  nome           String      @db.VarChar(255)
  valorPlanejado Float
  valorReal      Float?
  vencimento     DateTime?
  dataPago       DateTime?
  status         String      @default("Pendente") @db.VarChar(50)
  observacao     String?     @db.Text
  planoMensal    PlanoMensal @relation(fields: [planoMensalId], references: [id], onDelete: Cascade)

  @@map("contas_fixas")
}

model GastoVariavel {
  id             String      @id @default(uuid()) @db.VarChar(36)
  planoMensalId  String      @db.VarChar(36)
  nome           String      @db.VarChar(255)
  categoriaNome  String      @db.VarChar(255)
  categoriaIcone String      @default("💰") @db.VarChar(10)
  formaPagamento String      @db.VarChar(100)
  valorPlanejado Float
  valorReal      Float?
  valorUtilizado Float?
  data           DateTime?
  status         String      @default("Pendente") @db.VarChar(50)
  planoMensal    PlanoMensal @relation(fields: [planoMensalId], references: [id], onDelete: Cascade)

  @@map("gastos_variaveis")
}

model Meta {
  id            String      @id @default(uuid()) @db.VarChar(36)
  planoMensalId String      @db.VarChar(36)
  nome          String      @db.VarChar(255)
  tipo          String      @db.VarChar(100)
  metaTotal     Float
  valorMensal   Float
  totalGuardado Float       @default(0)
  onde          String?     @db.VarChar(255)
  data          DateTime?
  status        String      @default("Pendente") @db.VarChar(50)
  planoMensal   PlanoMensal @relation(fields: [planoMensalId], references: [id], onDelete: Cascade)

  @@map("metas")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  usuarioId String    @db.VarChar(36)
  tokenHash String    @unique @db.VarChar(512)
  expiresAt DateTime
  revokedAt DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
