generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String         @id @default(uuid())
  nome         String
  email        String         @unique
  senhaHash    String
  criadoEm    DateTime       @default(now())
  planos       PlanoMensal[]
  contas       ContaBancaria[]
  refreshTokens RefreshToken[]

  @@map("usuarios")
}

model ContaBancaria {
  id        String  @id @default(uuid())
  usuarioId String
  banco     String
  saldo     Float   @default(0)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("contas_bancarias")
}

model PlanoMensal {
  id               String         @id @default(uuid())
  usuarioId        String
  mes              Int
  ano              Int
  salarioReferencia Float
  criadoEm        DateTime       @default(now())
  usuario          Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  entradas         Entrada[]
  contasFixas      ContaFixa[]
  gastosVariaveis  GastoVariavel[]
  metas            Meta[]

  @@unique([usuarioId, mes, ano])
  @@map("planos_mensais")
}

model Entrada {
  id           String      @id @default(uuid())
  planoMensalId String
  nome         String
  valor        Float
  recebido     Boolean     @default(false)
  data         DateTime?
  planoMensal  PlanoMensal @relation(fields: [planoMensalId], references: [id], onDelete: Cascade)

  @@map("entradas")
}

model ContaFixa {
  id            String      @id @default(uuid())
  planoMensalId String
  nome          String
  valorPlanejado Float
  valorReal     Float?
  vencimento    DateTime?
  dataPago      DateTime?
  status        String      @default("Pendente")
  observacao    String?
  planoMensal   PlanoMensal @relation(fields: [planoMensalId], references: [id], onDelete: Cascade)

  @@map("contas_fixas")
}

model GastoVariavel {
  id            String      @id @default(uuid())
  planoMensalId String
  nome          String
  categoriaNome String
  categoriaIcone String     @default("💰")
  formaPagamento String
  valorPlanejado Float
  valorReal     Float?
  data          DateTime?
  status        String      @default("Pendente")
  planoMensal   PlanoMensal @relation(fields: [planoMensalId], references: [id], onDelete: Cascade)

  @@map("gastos_variaveis")
}

model Meta {
  id            String      @id @default(uuid())
  planoMensalId String
  nome          String
  tipo          String
  metaTotal     Float
  valorMensal   Float
  totalGuardado Float       @default(0)
  onde          String?
  data          DateTime?
  status        String      @default("Pendente")
  planoMensal   PlanoMensal @relation(fields: [planoMensalId], references: [id], onDelete: Cascade)

  @@map("metas")
}

model RefreshToken {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
